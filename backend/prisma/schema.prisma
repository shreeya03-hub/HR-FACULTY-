datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/@prisma/client"
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  role         String     // SUPER_ADMIN, HR_MANAGER, PRINCIPAL, DEAN, HOD, FACULTY, ACCOUNTS_OFFICER, NAAC_COORDINATOR, RECRUITMENT_OFFICER
  firstName    String
  lastName     String
  phone        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  faculty      Faculty?
  auditLogs    AuditLog[]
}

model Department {
  id          String           @id @default(uuid())
  name        String           @unique
  code        String           @unique
  description String?
  hodId       String?          @unique
  hod         Faculty?         @relation("DeptHOD", fields: [hodId], references: [id], onDelete: SetNull)
  faculties   Faculty[]        @relation("DeptFaculties")
  jobs        RecruitmentJob[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Faculty {
  id                 String           @id @default(uuid())
  userId             String           @unique
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId       String
  department         Department       @relation("DeptFaculties", fields: [departmentId], references: [id])
  designation        String
  dateOfJoining      DateTime
  dateOfBirth        DateTime
  gender             String
  panNumber          String?
  pfNumber           String?
  bankAccountNumber  String?
  bankName           String?
  ifscCode           String?
  basicPay           Float            @default(0.0)
  status             String           @default("ACTIVE") // ACTIVE, ON_LEAVE, SUSPENDED, RETIRED, TERMINATED
  profilePhotoUrl    String?
  resumeUrl          String?
  
  qualifications     Qualification[]
  experiences        Experience[]
  publications       Publication[]
  patents            Patent[]
  fdpRecords         FdpRecord[]
  attendances        Attendance[]
  leaveRequests      LeaveRequest[]
  leaveBalances      LeaveBalance[]
  payrolls           Payroll[]
  serviceRequests    ServiceRequest[]
  appraisals         Appraisal[]
  naacContributions  NaacContribution[]
  managedDepartment  Department?      @relation("DeptHOD")
  
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model Qualification {
  id             String   @id @default(uuid())
  facultyId      String
  faculty        Faculty  @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  degree         String
  specialization String
  institution    String
  university     String
  yearOfPassing  Int
  percentage     Float
  certificateUrl String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Experience {
  id                  String    @id @default(uuid())
  facultyId           String
  faculty             Faculty   @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  companyName         String
  designation         String
  fromDate            DateTime
  toDate              DateTime?
  totalYears          Float
  experienceLetterUrl String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model Publication {
  id               String          @id @default(uuid())
  facultyId        String
  faculty          Faculty         @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  type             String          // JOURNAL, CONFERENCE, BOOK, BOOK_CHAPTER
  title            String
  journalBookName  String
  volume           String?
  issue            String?
  pages            String?
  year             Int
  doi              String?
  link             String?
  proofUrl         String?
  status           String          @default("PENDING") // PENDING, APPROVED, REJECTED
  criteriaNaac     String?         // e.g. "3.4.4"
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model Patent {
  id                String       @id @default(uuid())
  facultyId         String
  faculty           Faculty      @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  title             String
  applicationNumber String       @unique
  status            String       @default("FILED") // FILED, PUBLISHED, GRANTED
  filingDate        DateTime
  grantDate         DateTime?
  proofUrl          String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

model FdpRecord {
  id             String   @id @default(uuid())
  facultyId      String
  faculty        Faculty  @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  type           String   // WORKSHOP, FDP, SEMINAR, CERTIFICATION, INDUSTRIAL_TRAINING
  title          String
  organization   String
  fromDate       DateTime
  toDate         DateTime
  durationDays   Int
  certificateUrl String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Attendance {
  id         String           @id @default(uuid())
  facultyId  String
  faculty    Faculty          @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  date       DateTime
  status     String           // PRESENT, ABSENT, LATE, ON_LEAVE
  punchIn    DateTime?
  punchOut   DateTime?
  totalHours Float?
  source     String           @default("BIOMETRIC") // BIOMETRIC, MANUAL
  remarks    String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([facultyId, date])
}

model LeaveRequest {
  id              String             @id @default(uuid())
  facultyId       String
  faculty         Faculty            @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  type            String             // CASUAL_LEAVE, SICK_LEAVE, EARNED_LEAVE, DUTY_LEAVE, MATERNITY_LEAVE
  startDate       DateTime
  endDate         DateTime
  totalDays       Float
  reason          String
  status          String             @default("PENDING_HOD") // PENDING_HOD, PENDING_HR, APPROVED, REJECTED
  supportingDocUrl String?
  remarks         String?
  approvedByHodId String?
  approvedByHrId  String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model LeaveBalance {
  id             String   @id @default(uuid())
  facultyId      String
  faculty        Faculty  @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  year           Int
  casualLeave    Float    @default(12)
  sickLeave      Float    @default(10)
  earnedLeave    Float    @default(15)
  dutyLeave      Float    @default(10)
  maternityLeave Float    @default(180)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([facultyId, year])
}

model Payroll {
  id             String        @id @default(uuid())
  facultyId      String
  faculty        Faculty       @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  month          Int
  year           Int
  basicPay       Float
  hra            Float
  da             Float
  allowances     Float         @default(0.0)
  grossSalary    Float
  pfDeduction    Float
  taxDeduction   Float
  otherDeductions Float        @default(0.0)
  totalDeductions Float
  netSalary      Float
  status         String        @default("DRAFT") // DRAFT, PROCESSED, PAID
  payslipPdfUrl  String?
  processedAt    DateTime?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([facultyId, month, year])
}

model RecruitmentJob {
  id                 String      @id @default(uuid())
  title              String
  departmentId       String
  department         Department  @relation(fields: [departmentId], references: [id])
  description        String
  requirements       String
  experienceRequired Float
  status             String      @default("OPEN") // OPEN, CLOSED
  candidates         Candidate[]
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
}

model Candidate {
  id           String          @id @default(uuid())
  jobId        String
  job          RecruitmentJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  firstName    String
  lastName     String
  email        String
  phone        String
  resumeUrl    String?
  status       String          @default("APPLIED") // APPLIED, SHORTLISTED, INTERVIEWED, OFFERED, JOINED, REJECTED
  rankingScore Float?          // AI ranking score out of 100
  aiFeedback   String?         // AI resume analysis
  interviews   Interview[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model Interview {
  id            String          @id @default(uuid())
  candidateId   String
  candidate     Candidate       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  interviewDate DateTime
  interviewerIds String         // Stored as JSON string list of user IDs
  mode          String          @default("ONLINE") // ONLINE, IN_PERSON
  status        String          @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED
  feedback      String?
  rating        Float?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model ServiceRequest {
  id          String                 @id @default(uuid())
  facultyId   String
  faculty     Faculty                @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  category    String                 // IT_SUPPORT, ID_CARD, EQUIPMENT, INFRASTRUCTURE_SUPPORT
  description String
  priority    String                 @default("MEDIUM") // LOW, MEDIUM, HIGH
  status      String                 @default("PENDING_DEPARTMENT") // PENDING_DEPARTMENT, PENDING_ADMIN, RESOLVED, REJECTED
  comments    String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
}

model Appraisal {
  id                String          @id @default(uuid())
  facultyId         String
  faculty           Faculty         @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  academicYear      String          // e.g. "2025-2026"
  teachingScore     Float           // 1 to 10
  researchScore     Float           // 1 to 10
  publicationsScore Float           // 1 to 10
  feedbackScore     Float           // 1 to 10
  fdpScore          Float           // 1 to 10
  selfRating        Float?
  selfComments      String?
  hodRating         Float?
  hodComments       String?
  deanRating        Float?
  deanComments      String?
  hrRating          Float?
  hrComments        String?
  status            String          @default("DRAFT") // DRAFT, HOD_REVIEW, DEAN_REVIEW, HR_REVIEW, APPROVED
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([facultyId, academicYear])
}

model NaacContribution {
  id          String               @id @default(uuid())
  facultyId   String
  faculty     Faculty              @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  type        String               // PUBLICATION, FDP, STUDENT_MENTORING, RESEARCH_GRANT, CONSULTANCY, EXTENSION_ACTIVITY
  title       String
  description String
  year        Int
  valueAmount Float?               // For grant, consultancy, etc.
  status      String               @default("PENDING") // PENDING, APPROVED
  proofUrl    String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  details   String
  ipAddress String?
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   @default("IN_APP") // IN_APP, EMAIL, SMS
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}
